[Unit]
Description=小陈的编程复习室与本机代码运行服务
After=graphical-session.target

[Service]
Type=simple
WorkingDirectory=/home/czq/桌面/学习总笔记/xiaochen-study-lab-source
ExecStart=/usr/bin/node /home/czq/桌面/学习总笔记/xiaochen-study-lab-source/cuda-runner.mjs
Restart=on-failure
RestartSec=2
Environment=NODE_ENV=production
EnvironmentFile=-/home/czq/.config/xiaochen-study/openai.env
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/czq/.config/xiaochen-study
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
UMask=0077

[Install]
WantedBy=default.target
